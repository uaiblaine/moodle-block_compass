{{!
    @template block_compass/block

    Shell of the Compass block. The server ships labels and configuration; the
    browser fetches course data and renders cards client-side (PLAN.md §3.2).
    Phase 0 renders the loading skeleton and lets the JS replace it with the
    placeholder label carried in the configuration.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="block_compass" on the root, carrying data-config, a JSON
      string with the client configuration and labels.
    * data-region="skeleton" on the status element the JS replaces.

    Context variables required for this template:
    * configjson - JSON string with the client configuration and labels.

    Example context (json):
    {
        "configjson": "{}"
    }
}}
<div id="block_compass-{{uniqid}}" class="compass-root" data-region="block_compass" data-config="{{configjson}}">
    <div class="compass-skeleton" data-region="skeleton" role="status" aria-live="polite">
        {{#str}}loading, core{{/str}}
    </div>
    <noscript>
        <p class="compass-noscript">{{#str}}javascriptrequired, block_compass{{/str}}</p>
    </noscript>
</div>
{{#js}}
require(['block_compass/main'], function(Main) {
    Main.init('block_compass-{{uniqid}}');
});
{{/js}}
