{{!
    @template block_compass/explore

    Tier 3: the explorable inventory (PLAN.md §2). Rendered client-side once,
    from the get_inventory payload; searching, sorting and the chips only toggle
    the hidden attribute or reorder nodes already in the DOM.

    Classes required for JS:
    * compass-narrow - toggled by the JS on the root when the section itself is narrow (hides the index).

    Data attributes required for JS:
    * data-region="explore-root" on the root.
    * data-region="search" on the search input (present only when search is enabled).
    * data-region="sort" on the sort group of toggle buttons (aria-pressed), data-sort on each.
    * data-region="chips" on the chip group of toggle buttons (aria-pressed), data-chip on each.
    * data-region="index-nav" on the category index, data-region="index" on its list; data-index-group on each link.
    * data-region="groups" wrapping the groups (see block_compass/group).
    * data-region="flat" on the empty list the rows move into when sorted by name or by last opened.
    * data-region="results" for the polite result announcement.
    * data-region="noresults" for the empty message.

    Context variables required for this template:
    * total - number of courses.
    * showsearch - whether the search box is shown.
    * showindex - whether the category index is shown.
    * groups - list of groups, see block_compass/group.
    * uniqid - a unique id (the js helper provides it).

    Example context (json):
    {
        "total": 91,
        "showsearch": true,
        "showindex": true,
        "groups": [
            {
                "id": 3, "name": "Police", "count": 2, "open": true,
                "courses": [
                    {"id": 7, "name": "Approach tactics", "opened": 1725000000, "new": false, "fav": true, "courseurl": "https://example.com/course/view.php?id=7"},
                    {"id": 9, "name": "Community policing", "opened": null, "new": true, "fav": false, "courseurl": "https://example.com/course/view.php?id=9"}
                ]
            }
        ]
    }
}}
<section class="compass-explore" data-region="explore-root" aria-labelledby="compass-explore-title-{{uniqid}}">
    <h3 class="compass-explore-title h5" id="compass-explore-title-{{uniqid}}">{{#str}}allcourses, block_compass, {{total}}{{/str}}</h3>
    <div class="compass-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
        {{#showsearch}}
        <div class="compass-search flex-grow-1">
            <label class="visually-hidden" for="compass-search-{{uniqid}}">{{#str}}searchcourses, block_compass{{/str}}</label>
            <input type="search" class="form-control form-control-sm" id="compass-search-{{uniqid}}" data-region="search"
                   placeholder="{{#str}}searchplaceholder, block_compass{{/str}}" autocomplete="off">
        </div>
        {{/showsearch}}
        <div class="compass-sort btn-group btn-group-sm" role="group" data-region="sort" aria-label="{{#str}}sortby, block_compass{{/str}}">
            <button type="button" class="btn btn-outline-secondary active" aria-pressed="true" data-sort="category">{{#str}}sort_category, block_compass{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" aria-pressed="false" data-sort="name">{{#str}}sort_name, block_compass{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" aria-pressed="false" data-sort="recent">{{#str}}sort_recent, block_compass{{/str}}</button>
        </div>
        <div class="compass-chips d-flex gap-1" role="group" data-region="chips" aria-label="{{#str}}filterby, block_compass{{/str}}">
            <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary active" aria-pressed="true" data-chip="all">{{#str}}chip_all, block_compass{{/str}}</button>
            <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary" aria-pressed="false" data-chip="new">{{#str}}chip_new, block_compass{{/str}}</button>
            <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary" aria-pressed="false" data-chip="favourites">{{#str}}chip_favourites, block_compass{{/str}}</button>
        </div>
    </div>
    <div class="compass-explore-body">
        {{#showindex}}
        <nav class="compass-index" data-region="index-nav" aria-label="{{#str}}categoryindex, block_compass{{/str}}">
            <ul class="list-unstyled small mb-0" data-region="index">
                {{#groups}}
                <li><a href="#compass-group-{{id}}-{{uniqid}}" class="d-flex justify-content-between text-decoration-none" data-index-group="{{id}}"><span>{{name}}</span><span class="text-muted" data-region="index-count">{{count}}</span></a></li>
                {{/groups}}
            </ul>
        </nav>
        {{/showindex}}
        <div class="compass-groups flex-grow-1" data-region="groups">
            {{#groups}}
            {{> block_compass/group }}
            {{/groups}}
        </div>
        <div class="compass-flat flex-grow-1" data-region="flat" role="list" hidden></div>
    </div>
    <p class="compass-noresults text-muted mt-2" data-region="noresults" hidden>{{#str}}noresults, block_compass{{/str}}</p>
    <span class="visually-hidden" data-region="results" role="status" aria-live="polite"></span>
</section>
