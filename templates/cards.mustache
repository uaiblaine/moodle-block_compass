{{!
    @template block_compass/cards

    A list of cards, rendered client-side into a strip, optionally closed by a
    ghost card. The list role lives here, around the items, so each template
    validates on its own and the ghost is a proper list item.

    Context variables required for this template:
    * cards - list of card objects, see block_compass/card.
    * ghost - optional ghost card object, see block_compass/ghost.

    Example context (json):
    {
        "cards": [
            {
                "id": 3, "fullname": "Community policing", "shortname": "CP-101",
                "url": "https://example.com/course/view.php?id=3", "imageurl": "", "hasimage": false,
                "category": "Police", "hascompletion": true, "progress": 62, "pending": false, "nodata": false,
                "iscomplete": false, "isfavourite": true, "isnew": false,
                "lastaccesstext": "Last access 2 hours ago", "enrolledtext": "", "deadlinetext": "",
                "actiontext": "Continue", "favouritesenabled": true
            }
        ],
        "ghost": {
            "count": 4, "text": "more new enrolments", "cta": "",
            "url": "https://example.com/my/courses.php", "kind": "new"
        }
    }
}}
<div class="compass-cards-list" role="list">
    {{#cards}}
    <div class="compass-cards-item" role="listitem">
        {{> block_compass/card }}
    </div>
    {{/cards}}
    {{#ghost}}
    <div class="compass-cards-item" role="listitem">
        {{> block_compass/ghost }}
    </div>
    {{/ghost}}
</div>
