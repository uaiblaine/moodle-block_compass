{{!
    @template block_compass/progress

    Progress bar of a card, rendered with the card or replaced when the pending
    progress arrives through block_compass_get_card_details.

    Context variables required for this template:
    * progress - integer percentage 0-100.
    * iscomplete - whether progress is 100.

    Example context (json):
    {
        "progress": 62,
        "iscomplete": false
    }
}}
<div class="progress compass-progress-bar" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}progresspercent, block_compass, {{progress}}{{/str}}">
    <div class="progress-bar{{#iscomplete}} bg-success{{/iscomplete}}" style="width: {{progress}}%"></div>
</div>
<span class="compass-progress-text small text-muted">{{#iscomplete}}{{#str}}completed, block_compass{{/str}}{{/iscomplete}}{{^iscomplete}}{{#str}}progresspercent, block_compass, {{progress}}{{/str}}{{/iscomplete}}</span>
