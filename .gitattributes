# Release hygiene — `git archive HEAD` builds the install zip, so every tracked
# path lands in the package unless it is export-ignore'd here. These paths are
# versioned for development/CI/collaboration but are NOT needed to run the
# plugin on a Moodle site, so they are stripped from the release zip.
# Note: tests/ SHIPS in the release (Moodle convention) — do not ignore it.
# Verify by listing the archive:  git archive HEAD | tar -t
# (a development path in the listing is the failure). Do not use `git check-attr
# export-ignore` for this: it answers for the path you name, so a file INSIDE an
# excluded directory reports "unspecified" while the directory keeps it out of
# the archive — measured on mutations/gates.conf and docs/perf/bench.sql.
/.DS_Store             export-ignore
/.claude               export-ignore
/.gitattributes        export-ignore
/.github               export-ignore
/.gitignore            export-ignore
/.moodle-plugin-ci.yml export-ignore
/.phpcsignore          export-ignore
/CLAUDE.md             export-ignore
/PLAN.md               export-ignore
/docs                  export-ignore
/lang/pt_br            export-ignore
/mutations             export-ignore
/phpcs.xml             export-ignore
/.mdlshield            export-ignore
# The development build: the source map of every per-file output and of the bundle. Only developer
# tools ask for one (the ESM route serves a .js.map on request; the import map, the preload hints
# and the bundle name .js files), so the package runs the same without them; they stay tracked
# because `mdl ci` compares js/esm with a fresh build. Moodle 5.2's build writes no X.dev.js twin
# (5.3's does); its rule is kept so the rules match the 5.3 branch and covers nothing here.
# bundle_test pins it: the maps' line, no .dev.js in the build, every file the import map can
# address kept.
/js/esm/build/*.dev.js  export-ignore
/js/esm/build/*.js.map  export-ignore
